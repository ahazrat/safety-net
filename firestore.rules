rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasAdminRole(data) {
      return 'roles' in data
        && 'ADMIN' in data.roles
        && data.roles.ADMIN == 'ADMIN';
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && hasAdminRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function badgesOf(data) {
      return 'badges' in data ? data.badges : {};
    }

    function validBadges(data) {
      return !('badges' in data)
        || data.badges.keys().hasOnly([
          'professional-demeanor',
          'complete-profile',
          'de-escalation',
          'self-defense',
          'personal-defense',
          'weapons-non-lethal',
          'weapons-lethal',
          'emergency-response',
          'cpr'
        ]);
    }

    function badgesUnchanged() {
      return badgesOf(request.resource.data) == badgesOf(resource.data);
    }

    // Profile docs keyed by Firebase Auth uid.
    // ADMIN and badges cannot be self-granted: only an existing admin may
    // set or clear them on someone else's user doc (bootstrap the first
    // admin in the Firebase console).
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && !hasAdminRole(request.resource.data)
        && validBadges(request.resource.data)
        && badgesOf(request.resource.data).keys().size() == 0;
      allow update: if request.resource.data.uid == resource.data.uid
        && validBadges(request.resource.data)
        && (
          (isOwner(userId)
            && hasAdminRole(request.resource.data) == hasAdminRole(resource.data)
            && badgesUnchanged())
          || (isAdmin() && userId != request.auth.uid)
        );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Marketplace listings.
    // visibility: 'public' (default) is readable by anyone; 'private' is
    // owner/admin only. List queries must constrain to public or to the
    // caller's ownerUid — unfiltered collection scans are denied once any
    // private listing exists.
    // Create requires a non-empty title, a lat/lng location, and a valid
    // visibility. ownerUid is stamped by the client helper and is immutable.
    function listingVisibility(data) {
      return !('visibility' in data) || data.visibility == 'public'
        ? 'public'
        : data.visibility;
    }

    function isPublicListing(data) {
      return listingVisibility(data) == 'public';
    }

    function validVisibility(data) {
      return listingVisibility(data) in ['public', 'private'];
    }

    function validListingShape(data) {
      return data.ownerUid is string
        && data.ownerUid.size() > 0
        && data.title is string
        && data.title.size() > 0
        && data.title.size() < 200
        && 'location' in data
        && data.location.lat is number
        && data.location.lng is number
        && validVisibility(data);
    }

    function canReadListing(data) {
      return isPublicListing(data)
        || isOwner(data.ownerUid)
        || isAdmin();
    }

    match /listings/{listingId} {
      allow get: if canReadListing(resource.data);
      // List must not call isAdmin()/get() — that makes queries
      // unconstrained. Admins still get() any listing by id.
      allow list: if isPublicListing(resource.data)
        || isOwner(resource.data.ownerUid);
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validListingShape(request.resource.data);
      allow update: if isSignedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || isAdmin()
        )
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validListingShape(request.resource.data);
      allow delete: if isSignedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || isAdmin()
        );
    }

    // Direct messages. Conversation ids are `{minUid}_{maxUid}`.
    // `participants` is denormalized onto each message so list queries
    // can use array-contains without get() on the parent.
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1];
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isSignedIn()
          && request.auth.uid in resource.data.participants;
        allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 2000
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.auth.uid in request.resource.data.participants
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            == request.resource.data.participants;
        allow update, delete: if false;
      }
    }
  }
}
