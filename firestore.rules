rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasAdminRole(data) {
      return 'roles' in data
        && 'ADMIN' in data.roles
        && data.roles.ADMIN == 'ADMIN';
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && hasAdminRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    // Profile docs keyed by Firebase Auth uid.
    // ADMIN cannot be self-granted: only an existing admin may set or
    // clear it on someone else's user doc (bootstrap the first admin in
    // the Firebase console).
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && !hasAdminRole(request.resource.data);
      allow update: if request.resource.data.uid == resource.data.uid
        && (
          (isOwner(userId)
            && hasAdminRole(request.resource.data) == hasAdminRole(resource.data))
          || (isAdmin() && userId != request.auth.uid)
        );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Marketplace listings. Public read so the signed-out Home/Map pins work.
    // Writes require ownerUid == auth.uid (stamped by createListing).
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || isAdmin()
        );
    }
  }
}
