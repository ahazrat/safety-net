{
  "name": "safety-net",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project safety-net-test \"node --test tests/firestore.rules.test.js\"",
    "test:validation": "node --test tests/validation.test.js",
    "test:linking": "node --test tests/linking.test.js",
    "test:auth": "node --test tests/auth.persistence.test.js",
    "test:crime": "node --test tests/chicago.crime.test.js",
    "test:scanners": "node --test tests/chicago.scanners.test.js",
    "test:geo": "node --test tests/chicago.geo.test.js",
    "test:stations": "node --test tests/chicago.stations.test.js",
    "test:money": "node --test tests/money.test.js",
    "test:listingType": "node --test tests/listingType.test.js",
    "test:badges": "node --test tests/badges.test.js",
    "test:team": "node --test tests/team.test.js",
    "deploy:rules": "bash scripts/firebase-gcloud-user.sh deploy --only firestore:rules --project safetynet-us",
    "build:web": "npm run build:web --workspace=@safety-net/app",
    "deploy:hosting": "npm run build:web && bash scripts/firebase-gcloud-user.sh deploy --only hosting --project safetynet-us"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^2.0.7",
    "firebase": "^9.14.0",
    "firebase-tools": "^13.29.1"
  }
}
